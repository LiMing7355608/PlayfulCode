# ============================================================
# PlayfulCode 环境变量样例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# CLI 会自动加载项目根目录下的 .env 文件
# ============================================================

# --- LLM 服务商（默认 deepseek）---
# 可选：deepseek | openai | moonshot | zhipu | dashscope | ollama | custom
PC_PROVIDER=deepseek

# 模型名（留空则使用该服务商默认模型）
PC_MODEL=

# 服务商预设地址兜底覆盖（一般无需填写）
PC_BASE_URL=

# --- API Key（按所选服务商填一个即可）---
PC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# --- Agent 行为参数 ---
# 单次任务内最多「推理-工具」轮次
PC_MAX_STEPS=16
# 单次 LLM 请求超时（毫秒）
PC_REQUEST_TIMEOUT_MS=120000
# LLM 失败重试次数（指数退避）
PC_MAX_RETRIES=3
# 上下文记忆保留的最近消息条数
PC_MEMORY_WINDOW=40
# 单轮 LLM 采样温度
PC_TEMPERATURE=0.2
# 单条工具输出注入上下文的最大字符数
PC_MAX_TOOL_OUTPUT_CHARS=12000

# --- 安全与沙箱 ---
# 危险工具（run_code / write_file / apply_patch）是否需要交互式审批：on | off
PC_REQUIRE_APPROVAL=on
# 允许工具访问的根目录（多个用 ; 或 , 分隔），留空表示不限制
PC_WORKSPACE_ROOTS=
# run_code 单次执行超时（毫秒）
PC_EXEC_TIMEOUT_MS=15000
# run_code 单次执行输出上限（字符）
PC_EXEC_MAX_OUTPUT=8000

# --- Web 界面 ---
PC_WEB_HOST=127.0.0.1
PC_WEB_PORT=3080

# --- 调试 ---
PC_LOG_LEVEL=info
PC_TRACE_FILE=
